      "label": {
        "en": "Print bleed",
        "es": "Sangrado de impresión",
        "fr": "Fond perdu",
        "pt": "Sangria de impressão"
      },
      "default": 3,
      "min": 0,
      "max": 6,
      "step": 0.1,
      "unit": "mm"
    },
    {
      "id": "flap",
      "type": "slider",
      "label": {
        "en": "Extra flap width",
        "es": "Ancho de solapa adicional",
        "fr": "Largeur du rabat supplémentaire",
