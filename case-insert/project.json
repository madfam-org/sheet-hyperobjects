  ],
  "parameters": [
    {
      "id": "style",
      "type": "select",
      "label": {
        "en": "Insert style",
        "es": "Tipo de inserto",
        "fr": "Type d’insert",
        "pt": "Tipo de inserto"
      },
      "default": "wrap",
      "options": [
        {
          "value": "wrap",
          "label": {
            "en": "Case wrap",
            "es": "Funda envolvente",
            "fr": "Jaquette enveloppante",
            "pt": "Capa envolvente"
          }
        },
        {
          "value": "tray-inlay",
          "label": {
            "en": "Tray inlay",
            "es": "Inserto de bandeja",
            "fr": "Insert de plateau",
            "pt": "Inserto de bandeja"
          }
        },
        {
          "value": "front",
          "label": {
            "en": "Front panel",
            "es": "Panel frontal",
            "fr": "Panneau avant",
            "pt": "Painel frontal"
          }
        }
      ]
    },
    {
      "id": "panel_w",
      "type": "slider",
      "label": {
        "en": "Panel width",
        "es": "Ancho del panel",
