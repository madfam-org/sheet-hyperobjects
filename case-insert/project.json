      "default": 0,
      "min": 0,
      "max": 30,
      "step": 0.5,
      "unit": "mm"
    },
    {
      "id": "fold_angle",
      "type": "slider",
      "label": {
        "en": "Fold angle",
        "es": "Ángulo de doblado",
        "fr": "Angle de pliage",
        "pt": "Ângulo de dobra"
      },
      "default": 90,
      "min": 0,
      "max": 90,
      "step": 1,
      "unit": "deg"
    },
    {
      "id": "stock",
      "type": "select",
      "label": {
        "en": "Paper",
        "es": "Papel",
        "fr": "Papier",
        "pt": "Papel"
      },
      "default": "copy-80",
      "options": [
        {
          "value": "copy-80",
          "label": {
            "en": "copy-80",
            "es": "copy-80",
            "fr": "copy-80",
            "pt": "copy-80"
          }
        },
        {
          "value": "elephant-hide-110",
          "label": {
            "en": "elephant-hide-110",
            "es": "elephant-hide-110",
            "fr": "elephant-hide-110",
            "pt": "elephant-hide-110"
          }
        },
        {
          "value": "cardstock-160",
          "label": {
            "en": "cardstock-160",
            "es": "cardstock-160",
            "fr": "cardstock-160",
            "pt": "cardstock-160"
          }
        }
      ]
    }
  ],
  "presets": [
