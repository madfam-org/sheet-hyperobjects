{
  "project": {
    "name": {
      "en": "Case insert",
      "es": "Inserto para estuche",
      "fr": "Insert de boîtier",
      "pt": "Inserto para estojo"
    },
    "slug": "case-insert",
    "version": "0.1.0",
    "engine": "pliego",
    "description": {
      "en": "Blank case wraps, tray inlays and front panels generated from paper-channel dimensions, with bleed, an optional flap and a native folding sequence.",
      "es": "Fundas de papel, insertos de bandeja y paneles frontales sin arte, generados a partir del canal del estuche, con sangrado, solapa opcional y secuencia nativa de doblado.",
      "fr": "Jaquettes, inserts de plateau et panneaux avant vierges générés à partir du logement papier du boîtier, avec fond perdu, rabat facultatif et séquence native de pliage.",
      "pt": "Capas, insertos de bandeja e painéis frontais sem arte, gerados a partir do canal de papel do estojo, com sangria, aba opcional e sequência nativa de dobra."
    },
    "difficulty": "beginner",
    "tags": [
      "packaging",
      "gaming",
      "hyperobject",
      "commons"
    ],
    "attribution": {
      "author": "Innovaciones MADFAM",
      "license": "CERN-OHL-W-2.0",
      "lineage": [
        {
          "source": "Original MADFAM geometry computed by this cartridge; example dimensions are labelled archetypes, not commercial product measurements.",
          "license": "original"
        }
      ]
    }
  },
  "modes": [
    {
      "id": "insert",
      "label": {
        "en": "Case insert",
        "es": "Inserto para estuche",
        "fr": "Insert de boîtier",
        "pt": "Inserto para estojo"
      },
      "script_file": "main.py",
      "sheets": [
        "insert"
      ]
    }
  ],
