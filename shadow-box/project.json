      "lineage": [
        {
          "source": "Original MADFAM design: box net, folded box-section spacers, fold program and the four scenes, all generated by main.py; layered cut scenes viewed in a box are a historical format (eighteenth-century perspective theatres and peepshows), credited to that history and not to any designer",
          "license": "original"
        }
      ]
    }
  },
