      "author": "Innovaciones MADFAM",
      "license": "CERN-OHL-W-2.0",
      "lineage": [
        {"source": "Original MADFAM geometry generated by main.py (gores developed from a latitude-longitude polyhedron of the sphere, with original colour patterns); globe gores are a historical globe-making technique, credited to that tradition; no map or gore artwork is reproduced", "license": "original"}
      ]
    }
  },
