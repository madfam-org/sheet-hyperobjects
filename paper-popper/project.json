      "lineage": [
        {
          "source": "Traditional paper banger (in Jinjo Kouto Shogaku Shuko Seisakuzu by Hideyoshi Okayama, 1903; history collected by the Public Paperfolding History Project, origamiheaven.com/historyofthepaperbanger.htm); geometry generated by this cartridge",
          "license": "public-domain"
        }
      ]
    }
