{
  "project": {
    "name": {
      "en": "Dissolve scene",
      "es": "Escena que se transforma",
      "fr": "Scène changeante",
      "pt": "Cena que se transforma"
    },
    "slug": "dissolve-scene",
    "version": "0.1.0",
    "engine": "pliego",
    "description": {
      "en": "A venetian-blind picture change: a window filled with slats, each printed with a band of one picture on its front and the matching band of another on its back. Turn every slat half a turn together and the first scene dissolves into the second.",
      "es": "Un cambio de imagen de persiana veneciana: una ventana llena de lamas, cada una impresa con una franja de una imagen en el frente y la franja correspondiente de otra en el reverso. Al girar todas las lamas media vuelta a la vez, la primera escena se transforma en la segunda.",
      "fr": "Un changement d'image à jalousie : une fenêtre garnie de lamelles, chacune imprimée d'une bande d'une image au recto et de la bande correspondante d'une autre au verso. On fait faire un demi-tour à toutes les lamelles ensemble et la première scène se change en la seconde.",
      "pt": "Uma troca de imagem de persiana: uma janela cheia de lâminas, cada uma impressa com uma faixa de uma imagem na frente e a faixa correspondente de outra no verso. Ao girar todas as lâminas meia volta juntas, a primeira cena se transforma na segunda."
    },
    "thumbnail": "/projects/dissolve-scene.svg",
    "difficulty": "intermediate",
    "tags": [
      "movable-book",
      "transformation",
      "venetian-blind",
      "louvre",
      "hinge",
      "paper-engineering",
      "hyperobject",
      "commons"
    ],
    "attribution": {
      "author": "Innovaciones MADFAM",
      "license": "CERN-OHL-W-2.0",
      "lineage": [
        {
          "source": "Original MADFAM geometry generated by main.py; slatted picture changes are a general device of movable books, credited to that tradition rather than to any designer or book",
          "license": "original"
        }
      ]
    }
  },
