  "project": {
    "name": {
      "en": "Perforated tear-off stub",
      "es": "Talón desprendible perforado",
      "fr": "Talon détachable perforé",
      "pt": "Canhoto destacável picotado"
    },
    "slug": "perforated-tear",
    "version": "0.1.0",
    "engine": "pliego",
    "description": {
      "en": "A card with a perforated stub, like a ticket. The perforation is a row of short cuts and bridges, a hinge weak enough to part: pull the stub and the strain gathers at the bridges until they tear.",
      "es": "Una tarjeta con un talón perforado, como un boleto. La perforación es una hilera de cortes cortos y puentes, una bisagra lo bastante débil para separarse: al jalar el talón, la deformación se concentra en los puentes hasta que se rompen.",
      "fr": "Une carte avec un talon perforé, comme un billet. La perforation est une rangée de courtes entailles et de ponts, une charnière assez faible pour céder : on tire sur le talon et la déformation se concentre sur les ponts jusqu'à ce qu'ils se déchirent.",
      "pt": "Um cartão com um canhoto picotado, como um ingresso. O picote é uma fileira de cortes curtos e pontes, uma dobradiça fraca o bastante para se separar: ao puxar o canhoto, a deformação se concentra nas pontes até que se rompam."
    },
    "difficulty": "beginner",
    "tags": [
      "technique",
      "perforation",
      "tear",
      "fabrication",
      "hyperobject",
      "commons"
    ],
    "attribution": {
      "author": "Innovaciones MADFAM",
