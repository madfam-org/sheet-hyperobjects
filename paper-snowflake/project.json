  "constraints": [
    {
      "expression": "hub * (0.47 * size - 1.25 * arm_width) * 0.577 > arm_width / 2 + 1.5",
      "severity": "error",
      "message": {
        "en": "The hub is too small for this arm width: enlarge the hub or the square, or thin the arms.",
        "es": "El centro es demasiado pequeño para este ancho de brazo: agranda el centro o el cuadrado, o adelgaza los brazos.",
        "fr": "Le centre est trop petit pour cette largeur de bras : agrandir le centre ou le carré, ou affiner les bras.",
        "pt": "O centro é pequeno demais para esta largura de braço: aumente o centro ou o quadrado, ou afine os braços."
      }
    }
  ],
