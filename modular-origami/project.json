      "label": {
        "en": "Unit size (mm)",
        "es": "Tamaño de la unidad (mm)",
        "fr": "Taille du module (mm)",
        "pt": "Tamanho da unidade (mm)"
      },
      "tooltip": {
        "en": "The cube's face, or the triangular unit's paper width (its paper is 2:3).",
        "es": "La cara del cubo, o el ancho del papel de la unidad triangular (su papel es 2:3).",
        "fr": "La face du cube, ou la largeur du papier du module triangulaire (son papier est en 2:3).",
        "pt": "A face do cubo, ou a largura do papel da unidade triangular (o seu papel é 2:3)."
      },
      "default": 40,
      "min": 24,
      "max": 90,
      "step": 1
    },
    {
      "id": "units",
      "type": "slider",
      "group": "ring",
      "unit": "count",
      "modes": [
        "wreath",
        "crown"
      ],
      "label": {
        "en": "Units in the ring",
        "es": "Unidades en el anillo",
        "fr": "Modules dans l'anneau",
        "pt": "Unidades no anel"
      },
      "default": 12,
      "min": 6,
      "max": 24,
      "step": 1
    },
    {
      "id": "depth",
      "type": "slider",
      "group": "ring",
      "unit": "ratio",
      "modes": [
        "wreath",
        "crown"
      ],
      "label": {
        "en": "How deep each point goes in",
        "es": "Qué tan hondo entra cada punta",
        "fr": "Profondeur d'insertion de chaque pointe",
        "pt": "Quão fundo entra cada ponta"
      },
      "tooltip": {
        "en": "Fraction of the unit's long leg that slides into the next pocket.",
        "es": "Fracción del cateto largo de la unidad que entra en el bolsillo siguiente.",
        "fr": "Fraction du grand côté du module qui glisse dans la poche suivante.",
        "pt": "Fração do cateto maior da unidade que entra no bolso seguinte."
      },
      "default": 0.55,
      "min": 0.3,
      "max": 0.75,
      "step": 0.05
    },
    {
      "id": "tilt",
      "type": "slider",
      "group": "ring",
      "unit": "deg",
      "modes": [
        "crown"
      ],
      "label": {
        "en": "Crown tilt (°)",
        "es": "Inclinación de la corona (°)",
        "fr": "Inclinaison de la couronne (°)",
        "pt": "Inclinação da coroa (°)"
      },
      "default": 70,
      "min": 20,
      "max": 85,
      "step": 1
    }
  ],
