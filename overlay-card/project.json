      "pt": "Cartão de sobreposição"
    },
    "slug": "overlay-card",
    "version": "0.1.0",
    "engine": "pliego",
    "description": {
      "en": "A blank card or PET overlay with keypad, display-window or explicit rectangular cutouts, checked for connected material and minimum bridges.",
