      "default": 20,
      "min": 5,
      "max": 60,
      "step": 0.5,
      "unit": "mm"
    },
    {
      "id": "pitch_y",
      "type": "slider",
      "label": {
        "en": "Vertical pitch",
        "es": "Paso vertical",
        "fr": "Pas vertical",
        "pt": "Passo vertical"
      },
      "default": 22,
      "min": 5,
      "max": 60,
      "step": 0.5,
      "unit": "mm"
    },
    {
      "id": "cutout_w",
      "type": "slider",
      "label": {
        "en": "Opening width",
        "es": "Ancho de abertura",
        "fr": "Largeur d’ouverture",
        "pt": "Largura da abertura"
      },
      "default": 12,
      "min": 3,
      "max": 250,
      "step": 0.1,
      "unit": "mm"
    },
    {
      "id": "cutout_h",
      "type": "slider",
      "label": {
        "en": "Opening height",
        "es": "Alto de abertura",
        "fr": "Hauteur d’ouverture",
        "pt": "Altura da abertura"
      },
      "default": 12,
      "min": 3,
      "max": 250,
      "step": 0.1,
      "unit": "mm"
    },
    {
      "id": "cutouts",
      "type": "text",
      "advanced": true,
      "label": {
        "en": "Custom openings: centre x,y,width,height",
        "es": "Aberturas: centro x,y,ancho,alto",
        "fr": "Ouvertures : centre x,y,largeur,hauteur",
        "pt": "Aberturas: centro x,y,largura,altura"
      },
      "tooltip": {
        "en": "Millimetres; separate rectangles with semicolons.",
        "es": "Milímetros; separa los rectángulos con punto y coma.",
        "fr": "Millimètres ; séparer les rectangles par des points-virgules.",
        "pt": "Milímetros; separe os retângulos por ponto e vírgula."
      },
      "default": "20,30,12,10;50,60,14,14"
    },
    {
      "id": "stock",
      "type": "select",
      "label": {
        "en": "Material",
        "es": "Material",
        "fr": "Matériau",
        "pt": "Material"
      },
      "default": "cardstock-250",
      "options": [
        {
          "value": "cardstock-250",
          "label": {
            "en": "Cardstock 250 g/m²",
            "es": "Cartulina 250 g/m²",
            "fr": "Bristol 250 g/m²",
            "pt": "Cartolina 250 g/m²"
          }
        },
        {
          "value": "pet-125",
          "label": {
            "en": "PET film 125 µm",
            "es": "Lámina de PET 125 µm",
            "fr": "Film PET 125 µm",
            "pt": "Filme PET 125 µm"
          }
        }
      ]
