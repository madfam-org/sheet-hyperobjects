      "type": "slider",
      "label": {
        "en": "Card width",
        "es": "Ancho de tarjeta",
        "fr": "Largeur de carte",
        "pt": "Largura do cartão"
      },
      "default": 80,
      "min": 40,
      "max": 300,
      "step": 0.1,
      "unit": "mm"
