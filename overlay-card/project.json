      "pet-125"
    ]
  },
  "hyperobject": {
    "is_hyperobject": true,
    "domain": "papercut",
    "kernel": "sheet",
    "interfaces": [
      {
        "id": "overlay_outline",
        "type": "custom",
        "label": {
          "en": "Overlay outline",
          "es": "Contorno de la tarjeta",
          "fr": "Contour de la carte",
          "pt": "Contorno do cartão"
        },
        "edges": [
          {
            "sheet": "overlay",
            "edge": "outline"
          }
        ],
        "parameters": [
          "panel_w",
          "panel_h",
          "corner_radius"
        ],
        "polarity": "neutral"
      }
    ],
    "capabilities": {
      "kinematic_program": false,
      "dieline": false,
      "artwork": false,
      "papercut": true,
      "minimum_bridge_checked": true,
      "static_overlay": true
    },
    "societal_benefit": {
      "en": "Build and size blank paper parts around documented contents.",
      "es": "Construye y dimensiona piezas de papel sin arte a partir del contenido documentado.",
      "fr": "Construire et dimensionner des pièces en papier vierges autour de contenus documentés.",
