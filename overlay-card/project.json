      "fr": "Une carte vierge en bristol ou PET avec ouvertures de clavier, fenêtre d’écran ou rectangles explicites, vérifiée pour la continuité de la matière et les ponts minimaux.",
      "pt": "Cartão de cartolina ou PET sem arte, com aberturas de teclado, janela de tela ou retângulos explícitos, verificado quanto à continuidade do material e às pontes mínimas."
    },
    "difficulty": "beginner",
    "tags": [
      "papercut",
      "gaming",
      "hyperobject",
      "commons"
    ],
    "attribution": {
      "author": "Innovaciones MADFAM",
      "license": "CERN-OHL-W-2.0",
      "lineage": [
        {
          "source": "Original MADFAM geometry computed by this cartridge; example dimensions are labelled archetypes, not commercial product measurements.",
          "license": "original"
        }
      ]
    }
  },
  "modes": [
    {
      "id": "overlay",
      "label": {
        "en": "Overlay card",
        "es": "Tarjeta superpuesta",
        "fr": "Carte de superposition",
        "pt": "Cartão de sobreposição"
      },
      "script_file": "main.py",
      "sheets": [
        "overlay"
      ]
    }
  ],
  "sheets": [
    {
      "id": "overlay",
      "label": {
        "en": "Overlay card",
        "es": "Tarjeta superpuesta",
        "fr": "Carte de superposition",
        "pt": "Cartão de sobreposição"
      },
      "stock": "cardstock-250"
    }
  ],
  "parameters": [
    {
      "id": "outline",
      "type": "select",
      "label": {
        "en": "Outline",
        "es": "Contorno",
        "fr": "Contour",
        "pt": "Contorno"
      },
      "default": "rounded",
      "options": [
        {
          "value": "rectangle",
          "label": {
            "en": "Rectangle",
            "es": "Rectángulo",
            "fr": "Rectangle",
            "pt": "Retângulo"
          }
        },
        {
          "value": "rounded",
          "label": {
            "en": "Rounded rectangle",
            "es": "Rectángulo redondeado",
            "fr": "Rectangle arrondi",
            "pt": "Retângulo arredondado"
          }
        }
      ]
    },
    {
      "id": "pattern",
      "type": "select",
      "label": {
        "en": "Openings",
        "es": "Aberturas",
        "fr": "Ouvertures",
        "pt": "Aberturas"
      },
      "default": "keypad",
      "options": [
        {
          "value": "keypad",
          "label": {
            "en": "Keypad grid",
            "es": "Retícula de teclado",
            "fr": "Grille de clavier",
            "pt": "Grade de teclado"
          }
        },
        {
          "value": "window",
          "label": {
            "en": "Display window",
            "es": "Ventana de pantalla",
            "fr": "Fenêtre d’écran",
            "pt": "Janela de tela"
          }
        },
        {
          "value": "custom",
          "label": {
            "en": "Custom rectangles",
            "es": "Rectángulos personalizados",
            "fr": "Rectangles personnalisés",
            "pt": "Retângulos personalizados"
          }
        }
      ]
    },
    {
